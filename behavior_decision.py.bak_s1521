#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
[S1114] 行为决策引擎 behavior_decision.py

流程：
  ① 扫描"取包后 6 小时内"的订单
  ② 对每个订单：读行为 → 算分 → 判定
  ③ 记录决策（可审计）
  ④ 灰度模式：只记录，不退款（dry_run=1）
  ⑤ 正式模式：得分>=阈值 → 自动退款（方式一：不管有没有提现）

使用方法：
  python3 behavior_decision.py --dry-run     # 只记录
  python3 behavior_decision.py --apply       # 实际退款
  python3 behavior_decision.py --stats       # 看统计
"""
import sys
import os
import json
import logging
import argparse
from datetime import datetime, timedelta

logging.basicConfig(level=logging.INFO, format='%(asctime)s [%(levelname)s] %(message)s')
logger = logging.getLogger('behavior_decision')

sys.path.insert(0, '/home/ubuntu/smart-locker')
from database import get_db
import behavior_scorer as bs


def to_dt(v):
    """把数据库返回的时间值统一成 datetime（兼容字符串）"""
    if v is None:
        return None
    if isinstance(v, datetime):
        return v
    s = str(v)[:19]
    for fmt in ('%Y-%m-%d %H:%M:%S', '%Y-%m-%dT%H:%M:%S'):
        try:
            return datetime.strptime(s, fmt)
        except Exception:
            continue
    return None


# ============================================================
# [S1483-20261020] 自动退款范围：只退"当前在用的商户号"，老渠道只观察
#   老板要求："行为画像除了今天的在用的商户号，之前的都不退，之观察"
#   口径：
#     · system_settings.behavior_auto_refund_channel_ids 非空 -> 只认这个列表（逗号分隔渠道id）
#     · 为空 -> 只认 payment_channels.is_active=1 且 auto_disabled=0 的微信渠道
#     · 判断失败 -> 一律不允许（宁可少退，绝不误退老渠道）
#   缓存 60 秒，避免每笔订单都查库（一次判定动辄几百笔）。
# ============================================================
_AUTO_REFUND_CH_CACHE = {'ts': 0, 'ids': None}


def _auto_refund_channel_allowed(db, channel_id):
    """这笔订单的渠道是否允许自动退款。异常一律返回 False。"""
    import time as _t
    try:
        _cid = int(channel_id) if channel_id is not None else 0
    except Exception:
        return False
    if _cid <= 0:
        return False   # 没渠道的订单不退（本来也会走 skipped）
    try:
        now = _t.time()
        if _AUTO_REFUND_CH_CACHE['ids'] is None or now - _AUTO_REFUND_CH_CACHE['ts'] > 60:
            _ids = None
            # 优先：显式配置
            try:
                cur0 = db.cursor()
                cur0.execute("SELECT setting_value FROM system_settings "
                             "WHERE setting_key='behavior_auto_refund_channel_ids'")
                _r = cur0.fetchone()
                _raw = str((_r['setting_value'] if isinstance(_r, dict) else (_r[0] if _r else '')) or '').strip()
                if _raw:
                    _ids = {int(x.strip()) for x in _raw.replace('，', ',').split(',') if x.strip().isdigit()}
            except Exception:
                _ids = None
            # 兜底：当前生效的微信渠道
            if _ids is None:
                try:
                    cur0 = db.cursor()
                    cur0.execute("SELECT id FROM payment_channels "
                                 "WHERE channel_type='wechat' AND is_active=1 "
                                 "AND COALESCE(auto_disabled,0)=0")
                    _ids = {int(r['id']) for r in cur0.fetchall()}
                except Exception:
                    _ids = set()
            _AUTO_REFUND_CH_CACHE['ids'] = _ids
            _AUTO_REFUND_CH_CACHE['ts'] = now
        return _cid in _AUTO_REFUND_CH_CACHE['ids']
    except Exception as _e:
        try:
            logger.warning('[S1483] 判断渠道是否可退失败(按不可退处理): %s', _e)
        except Exception:
            pass
        return False


def get_orders_to_judge(db, window_min=360):
    """
    取需要判定的订单：
      · status=3（已取包未退款）
      · 取包时间在 window_min 内
      · 未退款
      · ★ [S1139] 排除"设备补报"订单：store→retrieve > 12小时
        （设备离线后补报，retrieve_time 实际是补报时刻，不是真实取包时刻，
          用它判定会用错时间窗 -> 可能误退款。正常订单 95% 都在 6 小时内）
    """
    cur = db.cursor()
    try:
        cur.execute("""
            SELECT o.id AS id, o.order_no AS order_no, o.mp_openid AS mp_openid,
                   o.user_phone AS user_phone, o.deposit_amount AS deposit_amount,
                   o.retrieve_time AS retrieve_time, o.status AS status,
                   o.refund_time AS refund_time,
                   o.payment_channel_id AS payment_channel_id
            FROM orders o
            WHERE o.status = 3
              AND o.retrieve_time IS NOT NULL
              -- [S1336] 扫描范围放宽到 7 天（原来 24 小时），配合"6小时后~7天"的晚段规则。
              AND o.retrieve_time >= NOW() - INTERVAL '10080 minutes'
              AND o.refund_time IS NULL
              AND COALESCE(o.mp_openid,'') <> ''
              AND o.store_time IS NOT NULL
              AND EXTRACT(EPOCH FROM (o.retrieve_time - o.store_time)) <= 43200
              -- [S1370] 押金为 0 的订单（免费储物柜）不进判定队列：
              --   退了也是 0 元，只会走 skipped，纯浪费算力。
              --   实测 10-18 取包 167 笔里有 19 笔押金=0，全部来自渠道 133 免费柜。
              AND COALESCE(o.deposit_amount, 0) > 0
              -- [S1368] 减少无效扫描：
              --   ① 已处理过的（退过/无需退/退款失败）不再重判，扫出来也只是 continue
              --   ② [S1368b] 最近 30 分钟内判过的任何结果都不重判。
              --      原来是 6 小时，但那样"取包时正常、1小时后才开始焦急"的用户会漏判 6 小时。
              --      30 分钟既能跟上行为变化，又能把无效重判降下来（实测 30 分钟内全判过 -> 0 笔）。
              AND NOT EXISTS (
                  SELECT 1 FROM behavior_decision_log l
                  WHERE l.order_id = o.id
                    AND (l.action IN ('auto_refund','skipped','refund_failed')
                         OR l.created_at >= NOW() - INTERVAL '30 minutes')
              )
            ORDER BY o.retrieve_time DESC
        """)
        out = []
        for r in cur.fetchall():
            if isinstance(r, dict):
                d = {k: r.get(k) for k in ('id', 'order_no', 'mp_openid', 'user_phone',
                                           'deposit_amount', 'retrieve_time', 'status',
                                           'refund_time', 'payment_channel_id')}
            else:
                d = dict(zip(['id', 'order_no', 'mp_openid', 'user_phone', 'deposit_amount',
                              'retrieve_time', 'status', 'refund_time',
                              'payment_channel_id'], r))
            out.append(d)
        return out
    finally:
        cur.close()


def already_judged(db, order_id):
    """该订单是否已经判定过（避免重复）"""
    cur = db.cursor()
    try:
        cur.execute("""SELECT id AS a, is_high_risk AS b, action AS c FROM behavior_decision_log
                       WHERE order_id=%s ORDER BY id DESC LIMIT 1""", (order_id,))
        r = cur.fetchone()
        if not r:
            return None
        if isinstance(r, dict):
            return {'id': r.get('a'), 'is_high_risk': r.get('b'), 'action': r.get('c')}
        return {'id': r[0], 'is_high_risk': r[1], 'action': r[2]}
    finally:
        cur.close()


def do_refund(db, order, result):
    """[S1155修复] 真正调用 do_real_refund 做原路退款。

    原实现只 INSERT withdrawal_records(status=0) 等审批 -> 钱退不出去。
    现改为：直接调 helpers.do_real_refund()（它内部会更新 orders /
    user_balance_details / payments / cabinet_slots），再补一条
    withdrawal_records 供对账。返回 (refund_record_id, success, message)
    """
    cur = db.cursor()
    try:
        amount = float(order.get('deposit_amount') or 0)
        if amount <= 0:
            return None, False, '押金为0(无需退款)'
        # [S1275] 没有支付渠道 -> 退不了，直接跳过（不是故障）
        if not order.get('payment_channel_id'):
            return None, False, '无支付渠道(无需退款)'

        # 幂等1：订单是否已退款
        cur.execute("SELECT refund_status AS rs FROM orders WHERE id=%s", (order['id'],))
        r = cur.fetchone()
        rs = (r.get('rs') if isinstance(r, dict) else r[0]) if r else None
        if str(rs or '').strip().lower() in ('refunded', 'success', 'fee_refunded'):
            return None, True, '订单已退款(跳过)'

        # 幂等2：本系统是否已为这单退过
        cur.execute("""SELECT id AS i FROM withdrawal_records
                       WHERE order_id=%s AND approver=%s AND status=2 LIMIT 1""",
                    (order['id'], '行为规则自动退款'))
        ex = cur.fetchone()
        if ex:
            rid0 = ex.get('i') if isinstance(ex, dict) else ex[0]
            return rid0, True, '已由行为规则退款(跳过)'

        # ★ 真正退款
        from helpers import do_real_refund
        ok, chan_id, msg = do_real_refund(
            order_id=order['id'],
            amount=amount,
            openid=order.get('mp_openid') or ''
        )
        msg = str(msg or '')
        success = bool(ok) or ('已退款' in msg) or ('全额退款' in msg) or ('success' in msg.lower())

        # 补记 withdrawal_records（成功=2 / 失败=3）
        rec_id = None
        try:
            if success:
                cur.execute("""INSERT INTO withdrawal_records
                    (order_id, user_phone, amount, status, click_count, approver,
                     apply_time, approve_time, openid, error_msg)
                    VALUES (%s,%s,%s,2,0,%s,NOW(),NOW(),%s,%s) RETURNING id AS i""",
                    (order['id'], order.get('user_phone'), amount, '行为规则自动退款',
                     order.get('mp_openid'), ('渠道退款号:%s' % chan_id)[:200]))
            else:
                cur.execute("""INSERT INTO withdrawal_records
                    (order_id, user_phone, amount, status, click_count, approver,
                     apply_time, openid, error_msg)
                    VALUES (%s,%s,%s,3,0,%s,NOW(),%s,%s) RETURNING id AS i""",
                    (order['id'], order.get('user_phone'), amount, '行为规则自动退款',
                     order.get('mp_openid'), msg[:200]))
            row = cur.fetchone()
            rec_id = (row.get('i') if isinstance(row, dict) else row[0]) if row else None
            db.commit()
        except Exception as e2:
            logger.warning('[behavior_decision] 补记提现单失败: %s' % e2)
            try:
                db.rollback()
            except Exception:
                pass

        if success:
            logger.info('[行为退款成功] 订单%s 金额%.2f 渠道号%s' % (
                order.get('order_no'), amount, chan_id))
        else:
            logger.warning('[行为退款失败] 订单%s 金额%.2f 原因: %s' % (
                order.get('order_no'), amount, msg[:120]))
        return rec_id, success, msg
    except Exception as e:
        logger.error('[行为退款异常] 订单%s: %s' % (order.get('order_no'), e))
        try:
            db.rollback()
        except Exception:
            pass
        return None, False, str(e)
    finally:
        try:
            cur.close()
        except Exception:
            pass



def run(dry_run=True, window_min=360, verbose=False):
    """主流程"""
    db = get_db()
    bs.ensure_tables(db)
    cfg = bs.load_config(db)
    if not cfg['enabled']:
        logger.info('打分功能已关闭（enabled=0）')
        return
    th = cfg['threshold']
    table = cfg['table']
    win = window_min or cfg['window_min']

    orders = get_orders_to_judge(db, win)
    logger.info('待判定订单: %d 笔（窗口 %d 分钟，阈值 %.1f 分，dry_run=%s）' % (
        len(orders), win, th, dry_run))

    n_judged = n_risk = n_refund = 0
    for o in orders:
        o['retrieve_time'] = to_dt(o.get('retrieve_time'))
        t_from = o['retrieve_time']
        # [S1331] 特征查询放宽到取包后 24 小时：
        #   早段（取包~+6h）照旧算全部特征，语义不变；
        #   晚段（+6h~+24h）只算 dedup_money_late，用于"6 小时后还在找钱"的兜底。
        # [S1336] 晚段窗口从"6~24小时"放宽到"6小时~7天"（老板 10-18 定）：
        #   实测 1-3 天能满足晚段规则的 89 单、3-7 天 133 单，共多覆盖约 222 单 ¥4,289；
        #   7 天以上量太大（15-30天 9,915 单、30天以上 57,573 单），不放进这条高频任务。
        t_to = (t_from + timedelta(days=7)) if t_from else datetime.now()
        late_from = (t_from + timedelta(hours=6)) if t_from else None
        feat = bs.features_from_log(db, o['mp_openid'], t_from, t_to, late_from=late_from)
        result = bs.judge(feat, table, th)
        # [S1419] 补充判定：拒绝订阅(43101) + 取包后无任何行为 => 直接高风险
        #   实测(10-17~10-19)：这条单独抓 10/26 投诉，真白退仅 2 笔 ¥43。
        try:
            if not result.get("is_high_risk"):
                _sb = None
                _c_sb = db.cursor()
                try:
                    _c_sb.execute(
                        "SELECT COUNT(*) FILTER (WHERE status='ok') AS n_ok, "
                        "COUNT(*) FILTER (WHERE err_code=43101) AS n_refuse "
                        "FROM user_subscribe_status WHERE openid=%s",
                        (o.get("mp_openid") or "",))
                    _sb = _c_sb.fetchone()
                finally:
                    _c_sb.close()
                _n_ok = int((_sb.get("n_ok") if isinstance(_sb, dict) else _sb[0]) or 0) if _sb else 0
                _n_rf = int((_sb.get("n_refuse") if isinstance(_sb, dict) else _sb[1]) or 0) if _sb else 0
                _has_beh = False
                _t0 = o.get("retrieve_time")
                if _t0:
                    _c_bh = db.cursor()
                    try:
                        _c_bh.execute(
                            "SELECT 1 FROM user_behavior_log "
                            "WHERE openid=%s AND created_at >= %s "
                            "AND created_at < %s + INTERVAL '6 hours' LIMIT 1",
                            (o.get("mp_openid") or "", _t0, _t0))
                        _has_beh = _c_bh.fetchone() is not None
                    finally:
                        _c_bh.close()
                if _n_ok == 0 and _n_rf > 0 and not _has_beh:
                    result = {
                        "score": 6.0,
                        "is_high_risk": True,
                        "hits": [{"signal": "sub_refuse_nobeh", "points": 6.0,
                                  "detail": "refused_subscribe_and_no_behavior"}],
                    }
                    logger.info("[S1419] 订阅拒绝+无行为 命中: order=%s", o.get("order_no"))
        except Exception as _e_s1419:
            logger.warning("[S1419] 补充判定异常: %s", _e_s1419)

        n_judged += 1
        if result['is_high_risk']:
            n_risk += 1
        action = 'record_only'
        refund_id = None
        if result['is_high_risk']:
            prev = already_judged(db, o['id'])
            if prev and prev['action'] == 'auto_refund':
                continue    # 已退过，跳过
            # [S1279] 已判定过"无需退款"(押金0/无渠道)的，不必每10分钟重试
            if prev and prev['action'] == 'skipped':
                continue
            # [S1363] 退款失败过的不再自动重试。
            #   原因：渠道余额不足时，每 10 分钟重扫会重复调微信退款接口，
            #   实测近 3 小时同一订单最多重试 4 次、累计 1,703 次失败调用，
            #   每分钟 8-11 次失败请求有触发微信风控/限制收款的风险。
            #   这类订单改由人工（充值后）或后台手动处理。
            if prev and prev['action'] == 'refund_failed':
                continue
            if dry_run:
                action = 'record_only'
            elif not _auto_refund_channel_allowed(db, o.get('payment_channel_id')):
                # [S1483-20261020] 老板要求：只对"当前在用的商户号"自动退款。
                #   老渠道（已停用）的订单只记录观察，绝不调微信退款。
                action = 'observe_only'
                logger.info('[S1483] 渠道不在自动退款范围(只观察) order=%s channel=%s',
                            o.get('order_no'), o.get('payment_channel_id'))
            else:
                refund_id, ok, msg = do_refund(db, o, result)
                if ok:
                    action = 'auto_refund'
                    n_refund += 1
                else:
                    # [S1275] 区分"不用退"和"真失败"：
                    #   押金为0 / 无支付渠道 / 订单已退 -> skipped（不是故障）
                    _m = str(msg or '')
                    if ('押金为0' in _m or '无渠道' in _m or '已退' in _m
                            or '无需' in _m or '跳过' in _m):
                        action = 'skipped'
                    else:
                        action = 'refund_failed'
        bs.log_decision(db, o, feat, result, action=action,
                        dry_run=dry_run, refund_id=refund_id, window_min=win)
        if verbose and result['is_high_risk']:
            logger.info('  ★订单%s 得分%.0f → %s | %s' % (
                o['order_no'], result['score'], action, result['reason']))

    logger.info('完成：判定 %d 笔，高风险 %d 笔，实际退款 %d 笔' % (n_judged, n_risk, n_refund))
    print_stats(db)
    db.close()


def print_stats(db):
    """统计"""
    cur = db.cursor()
    try:
        cur.execute("""SELECT COUNT(*) AS 总数,
                              COUNT(*) FILTER (WHERE is_high_risk=1) AS 高风险,
                              COUNT(*) FILTER (WHERE action='auto_refund') AS 已退款,
                              COALESCE(SUM(deposit_amount) FILTER (WHERE is_high_risk=1),0) AS 金额
                       FROM behavior_decision_log WHERE created_at >= NOW() - INTERVAL '14 days'""")
        r = cur.fetchone()
        print('\n  ── 近14天决策统计 ──')
        print('     判定总数: %d 笔' % r[0])
        print('     高风险:   %d 笔 (%.1f%%)' % (r[1], 100.0*r[1]/max(r[0],1)))
        print('     已退款:   %d 笔' % r[2])
        print('     涉及金额: %.2f 元' % r[3])
        cur.execute("""SELECT hits FROM behavior_decision_log
                       WHERE is_high_risk=1 AND created_at >= NOW() - INTERVAL '14 days'""")
        from collections import Counter
        c = Counter()
        for (h,) in cur.fetchall():
            if not h: continue
            # [S1273] 兜底：历史脏数据(空串/非JSON)不能让统计炸掉
            try:
                _items = h if isinstance(h, list) else json.loads(h)
            except Exception:
                continue
            if not isinstance(_items, list):
                continue
            for item in _items:
                if isinstance(item, dict) and item.get('signal'):
                    c[item.get('signal')] += 1
        if c:
            print('\n  ── 命中信号分布 ──')
            for k, v in c.most_common():
                print('     %-24s %d 次' % (k, v))
    finally:
        cur.close()


if __name__ == '__main__':
    ap = argparse.ArgumentParser()
    ap.add_argument('--apply', action='store_true', help='实际退款（默认只记录）')
    ap.add_argument('--window', type=int, default=0, help='判定窗口（分钟）')
    ap.add_argument('--stats', action='store_true', help='只看统计')
    ap.add_argument('--verbose', action='store_true')
    a = ap.parse_args()
    if a.stats:
        db = get_db(); print_stats(db); db.close()
    else:
        run(dry_run=not a.apply, window_min=a.window, verbose=a.verbose)
