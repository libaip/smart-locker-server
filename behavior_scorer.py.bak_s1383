#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
[S1113] 行为打分模块 behavior_scorer.py

功能：
  ① 从 user_behavior_log（或 nginx 日志）提取用户行为特征
  ② 按可配置的打分表算分
  ③ 得分 >= 阈值 → 判定为"高投诉风险"
  ④ 记录决策过程（可审计）

设计要点（借鉴开源方案）：
  · 规则可配置：打分表/阈值存数据库，不用改代码
  · 决策记录：每次判定都写日志（得分、命中信号）
  · 灰度开关：先只记录不退款
"""
import logging
import json
from datetime import datetime, timedelta

logger = logging.getLogger(__name__)

# ══════════════════════════════════════════════════════════
# 默认打分表（可被数据库配置覆盖）
# ══════════════════════════════════════════════════════════
DEFAULT_SCORE_TABLE = [
    # [S1319] ** 核心规则（老板 10-17 拍板）：去重后"看钱"次数 >= 8 次
    #   背景：旧的 "一次点15下" / "burst>=8" 用的都是【原始埋点条数】，
    #         而前端一次页面加载会把 balance 连打 5-11 次（实测同秒最多 18 条、14 条重复），
    #         所以旧规则实际在测"前端请求次数" —— 投诉组反而更低（0.89 倍，方向相反）。
    #   口径：balance + withdrawals + transactions 三类"找钱"页面，
    #         同一秒同一接口只算 1 次（去重）。
    #   回测(近7天)：投诉组均值 11.68 vs 正常组 5.14（2.27 倍）；
    #         >=8 命中 1,220 单/7天、命中组投诉率 0.82%（基线 0.48%，1.71 倍）；
    #         124 单投诉里能提前拦住 20 单（16%），每天约 2.9 单；
    #         命中未退订单 310 单/7天、押金 ¥5,817（每天约 44 单 ¥831）。
    ('dedup_money_ge_8', 'dedupmoney', 8, 6),
    # [S1331] 兜底：取包 6 小时后（6~24h）还在反复看钱 >= 10 次 也给 6 分。
    #   数据显示这批人 72-88% 最终会自己退款，真实成本极低（约 ¥40/7天），
    #   且 267 单里投诉 0 单 —— 纯粹是"减少用户等钱时间"的兜底，不会误伤投诉型用户。
    ('dedup_money_late_ge_10', 'dedupmoney_late', 10, 6),
    # [S1335] 晚段也判"一次点 15 下"：6 小时后才打开小程序、但一次狂点 >=15 下同样判焦急。
    #   实测 #14(16下) / #22(34下) 就是被这条漏掉的；7 天影响约 132 单 ¥2,682。
    ('single_session_late_ge_15', 'maxtaps_late', 15, 6),
    # (信号名, 类型, 阈值, 分值)
    ('requests_ge_40',    'req',  40,  3),
    ('requests_ge_20',    'req',  20,  1),
    ('balance_ge_10',     'bal',  10,  1),
    ('viewed_withdrawals','wd',   1,   1),
    ('viewed_transactions','tx',  1,   1),
    ('stay_ge_60s',       'dur',  60,  1),
    ('pages_ge_4',        'pages',4,   1),
    ('orders_ge_5',       'ord',  5,   1),
    ('stay_ge_120s',      'dur',  120, 1),
    ('stay_ge_30s',       'dur',  30,  1),
]
DEFAULT_THRESHOLD = 6          # 得分 >= 6 触发
DEFAULT_WINDOW_MIN = 360       # 判定窗口：取包后 6 小时


# ══════════════════════════════════════════════════════════
# 特征提取
# ══════════════════════════════════════════════════════════
def extract_features(events, gap_seconds=1800, late_from=None):
    """
    从行为事件列表提取特征

    events: [(datetime, path), ...]
    gap_seconds: 会话切分间隔（默认30分钟）

    返回 dict 或 None（无行为时）
    """
    if not events:
        return None
    evs = sorted(events, key=lambda x: x[0])
    # [S1331] 晚段（如取包后 6~24 小时）单独算"看钱次数"：
    #   早段（取包~+6h）继续算全部特征，语义完全不变；
    #   晚段只用 dedup_money_late 这一条，避免总数被拉长窗口后虚高。
    _late_evs = []
    if late_from is not None:
        _late_evs = [e for e in evs if e[0] >= late_from]
        evs = [e for e in evs if e[0] < late_from]
        # [S1334] 不能因为"早段没行为"就直接 return None ——
        #   否则那些【只在取包 6 小时后才打开小程序】的用户会被整条丢掉，
        #   而他们恰恰是"6~24小时兜底"规则要覆盖的人（实测 #14/#22 两笔被吞）。
        #   早段空时把所有计数类特征按 0 处理，让晚段 dedup_money_late 仍能算出来。
        if not evs:
            _late_taps2 = 0
            if _late_evs:
                _ls2 = []
                _c2 = [_late_evs[0]]
                for _e2 in _late_evs[1:]:
                    if (_e2[0] - _c2[-1][0]).total_seconds() > gap_seconds:
                        _ls2.append(_c2); _c2 = [_e2]
                    else:
                        _c2.append(_e2)
                _ls2.append(_c2)
                _late_taps2 = max((len(_s2) for _s2 in _ls2), default=0)
            _late_money_seen2 = set()
            _late_money2 = 0
            for _t3, _p3 in _late_evs:
                _k3 = ''
                if _p3.startswith('/api/user/balance'):
                    _k3 = 'balance'
                elif _p3.startswith('/api/user/wallet/withdrawals'):
                    _k3 = 'wd'
                elif _p3.startswith('/api/user/wallet/transactions'):
                    _k3 = 'tx'
                if not _k3:
                    continue
                _kk3 = (_t3.replace(microsecond=0), _k3)
                if _kk3 in _late_money_seen2:
                    continue
                _late_money_seen2.add(_kk3)
                _late_money2 += 1
            _late_pages2 = set()
            for _t4, _p4 in _late_evs:
                if _p4.startswith('/api/user/balance'):
                    _late_pages2.add('balance')
                elif _p4.startswith('/api/user/wallet/withdrawals'):
                    _late_pages2.add('wd')
                elif _p4.startswith('/api/user/wallet/transactions'):
                    _late_pages2.add('tx')
                elif _p4.startswith('/api/user/orders'):
                    _late_pages2.add('orders')
                elif _p4.startswith('/api/user/info'):
                    _late_pages2.add('info')
            return {
                'req': 0, 'sessions': 0, 'max_taps': 0, 'sum_taps': 0,
                'max_taps_late': _late_taps2,
                'dedup_money': 0, 'dedup_money_late': _late_money2,
                'max_burst_10s': 0, 'burst_small': 0,
                'avg_dur': 0, 'max_dur': 0, 'pages': len(_late_pages2),
                'bal': sum(1 for _, p in _late_evs if p.startswith('/api/user/balance')),
                'wd': any(p.startswith('/api/user/wallet/withdrawals') for _, p in _late_evs),
                'tx': any(p.startswith('/api/user/wallet/transactions') for _, p in _late_evs),
                'ord': sum(1 for _, p in _late_evs if p.startswith('/api/user/orders')),
                'first_ts': _late_evs[0][0] if _late_evs else None,
                'last_ts': _late_evs[-1][0] if _late_evs else None,
            }
    # 会话切分
    sessions = []
    cur = [evs[0]]
    for e in evs[1:]:
        if (e[0] - cur[-1][0]).total_seconds() > gap_seconds:
            sessions.append(cur)
            cur = [e]
        else:
            cur.append(e)
    sessions.append(cur)

    durations = [(s[-1][0] - s[0][0]).total_seconds() for s in sessions]
    pages = set()
    bal = wd = tx = ord_ = 0
    for _, path in evs:
        if path.startswith('/api/user/balance'):
            pages.add('balance'); bal += 1
        elif path.startswith('/api/user/wallet/transactions'):
            pages.add('tx'); tx += 1
        elif path.startswith('/api/user/wallet/withdrawals'):
            pages.add('wd'); wd += 1
        elif path.startswith('/api/user/orders'):
            pages.add('orders'); ord_ += 1
        elif path.startswith('/api/user/order-detail'):
            pages.add('order_detail')
        elif path.startswith('/api/user/info'):
            pages.add('info')
        elif path.startswith('/api/user/withdraw'):
            pages.add('withdraw')
        elif path.startswith('/api/user/help-refund'):
            pages.add('help')
        elif path.startswith('/api/retrieve'):
            pages.add('retrieve')
        elif path.startswith('/api/deposit'):
            pages.add('deposit')
        else:
            pages.add('other')

    # [S1319] 去重后的"看钱"次数：余额/提现记录/交易流水，
    #   同一秒内同一接口只算 1 次 —— 因为前端一次页面加载会把 balance 连打 5-11 次，
    #   按原始条数算会把"一次刷新"误算成十几次（实测同秒最多 18 条、其中 14 条重复）。
    #   注意：evs 里第二项是【path】(/api/user/balance)，不是 action 名，必须按前缀匹配。
    _money_seen = set()
    _dedup_money = 0
    for _t, _p in evs:
        _kind = ''
        if _p.startswith('/api/user/balance'):
            _kind = 'balance'
        elif _p.startswith('/api/user/wallet/withdrawals'):
            _kind = 'wd'
        elif _p.startswith('/api/user/wallet/transactions'):
            _kind = 'tx'
        if not _kind:
            continue
        _k = (_t.replace(microsecond=0), _kind)
        if _k in _money_seen:
            continue
        _money_seen.add(_k)
        _dedup_money += 1

    # [S1335] 晚段也要判"一次点 15 下"：
    #   原来晚段只算 dedup_money_late，导致"6 小时后才打开小程序、但一次狂点几十下"的用户
    #   完全抓不到（实测 #14 晚段一次点 16 下、#22 一次点 34 下，都漏了）。
    #   这里对晚段单独做 30 分钟会话切分，算最大一次会话的操作数。
    _late_taps = 0
    if _late_evs:
        _ls = []
        _cur_s = [_late_evs[0]]
        for _e in _late_evs[1:]:
            if (_e[0] - _cur_s[-1][0]).total_seconds() > gap_seconds:
                _ls.append(_cur_s); _cur_s = [_e]
            else:
                _cur_s.append(_e)
        _ls.append(_cur_s)
        _late_taps = max((len(_s) for _s in _ls), default=0)

    # [S1331] 晚段"看钱"次数（同样按秒去重）
    _late_money_seen = set()
    _late_money = 0
    for _t2, _p2 in _late_evs:
        _k2 = ''
        if _p2.startswith('/api/user/balance'):
            _k2 = 'balance'
        elif _p2.startswith('/api/user/wallet/withdrawals'):
            _k2 = 'wd'
        elif _p2.startswith('/api/user/wallet/transactions'):
            _k2 = 'tx'
        if not _k2:
            continue
        _kk = (_t2.replace(microsecond=0), _k2)
        if _kk in _late_money_seen:
            continue
        _late_money_seen.add(_kk)
        _late_money += 1

    # [S1311] 10 秒滑动窗口内最大请求数（双指针，O(n)）
    _burst = 0
    _j = 0
    _n1299 = len(evs)
    for _i in range(_n1299):
        while _j < _n1299 and (evs[_j][0] - evs[_i][0]).total_seconds() <= 10:
            _j += 1
        _c = _j - _i
        if _c > _burst:
            _burst = _c

    return {
        'req': len(evs),                          # 总请求数
        'sessions': len(sessions),                # 进入次数
        # [S1272] 单次进入里的最大操作数（判断"打开一次、在里面狂点"）
        'max_taps': max((len(s) for s in sessions), default=0),
        # [S1272] 累计操作数
        'sum_taps': sum(len(s) for s in sessions),
        # [S1311] 10 秒滑动窗口内的最大请求数 —— "疯狂刷新找钱"特征
        #   老板点名：10-17 订单 20261017084643660939 只点了 8 下（7.8 秒内完成），
        #   因为旧规则要求"一次>=15下"拿不到分，只得了 2 分没触发。
        #   但 8 次操作挤在 7.8 秒内，是典型的"反复刷新、找钱"焦急表现。
        'dedup_money': _dedup_money,   # [S1319] 去重后"看钱"次数（核心信号）
        'dedup_money_late': _late_money,   # [S1331] 取包6小时后那段"看钱"次数
        'max_taps_late': _late_taps,   # [S1335] 取包6小时后最大一次会话操作数
        'max_burst_10s': _burst,
        # [S1312] 老板口径：只看"总次数少但摄得极快"的人（真正的焦急乱点）。
        #   总次数 > 15 的交给 single_session_ge_15 抓，不重复计分。
        #   回测(7天9247单)：burst>=8 单独用命中 4339 单(47%)、命中组投诉率 0.51%（区分度差）；
        #   叠加"总次数<=15"后只留"总次数少+极快"这一窄口径。
        'burst_small': (_burst if len(evs) <= 15 else 0),
        'avg_dur': sum(durations) / max(len(durations), 1),   # 平均停留(秒)
        'max_dur': max(durations) if durations else 0,
        'pages': len(pages),                      # 访问页面种类
        'bal': bal,                               # 查余额次数
        'wd': wd > 0,                             # 是否看过提现记录
        'tx': tx > 0,                             # 是否看过交易流水
        'ord': ord_,                              # 查订单次数
        'first_ts': evs[0][0],
        'last_ts': evs[-1][0],
    }


# ══════════════════════════════════════════════════════════
# 打分
# ══════════════════════════════════════════════════════════
# 打分表 signal_type → 特征字段名 的映射
# （打分表用简写，特征是完整名）
TYPE_MAP = {
    'dur': 'avg_dur',       # 停留时长
    'maxdur': 'max_dur',
    'maxtaps': 'max_taps',  # [S1272] 单次进入最大操作数
    'burst10': 'max_burst_10s',  # [S1311] 10秒内最大请求数
    'dedupmoney': 'dedup_money',  # [S1319] 去重后看钱次数
    'dedupmoney_late': 'dedup_money_late',  # [S1331] 6小时后看钱次数
    'maxtaps_late': 'max_taps_late',  # [S1335] 6小时后最大一次操作数
    'burstsmall': 'burst_small',  # [S1312] 10秒内最大请求数（仅当总次数<=15）
    'sumtaps': 'sum_taps',  # [S1272] 累计操作数
    'sess': 'sessions',
    'req': 'req',
    'bal': 'bal',
    'pages': 'pages',
    'ord': 'ord',
    'wd': 'wd',
    'tx': 'tx',
}


def score_features(feat, score_table=None):
    """
    按打分表算分

    返回 (总分, 命中的信号列表)
    """
    if not feat:
        return 0, []
    table = score_table or DEFAULT_SCORE_TABLE
    total = 0
    hit = []
    for name, kind, th, pts in table:
        key = TYPE_MAP.get(kind, kind)
        v = feat.get(key)
        if v is None:
            continue
        if key in ('wd', 'tx'):
            ok = bool(v) if th >= 1 else True
        else:
            ok = (v or 0) >= th
        if ok:
            total += pts
            hit.append({'signal': name, 'value': v, 'points': pts})
    return total, hit


def judge(feat, score_table=None, threshold=None):
    """
    判定：得分 >= 阈值 → 高风险

    返回 dict:
      {score, hits, threshold, is_high_risk, reason}
    """
    th = threshold if threshold is not None else DEFAULT_THRESHOLD
    total, hits = score_features(feat, score_table)
    is_risk = total >= th
    reason = '得分%d>=%d：%s' % (total, th, '+'.join(h['signal'] for h in hits)) if is_risk else ''
    return {
        'score': total,
        'hits': hits,
        'threshold': th,
        'is_high_risk': is_risk,
        'reason': reason,
    }


# ══════════════════════════════════════════════════════════
# 数据库：配置读取 / 决策记录
# ══════════════════════════════════════════════════════════
def ensure_tables(db):
    """建配置表和决策记录表（幂等）"""
    cur = db.cursor()
    cur.execute("""
        CREATE TABLE IF NOT EXISTS behavior_score_config (
            id SERIAL PRIMARY KEY,
            signal_name TEXT NOT NULL,
            signal_type TEXT NOT NULL,
            threshold NUMERIC NOT NULL,
            points NUMERIC NOT NULL,
            enabled SMALLINT DEFAULT 1,
            remark TEXT,
            updated_at TIMESTAMP DEFAULT NOW(),
            UNIQUE(signal_name)
        )
    """)
    cur.execute("""
        CREATE TABLE IF NOT EXISTS behavior_score_settings (
            key TEXT PRIMARY KEY,
            value TEXT,
            updated_at TIMESTAMP DEFAULT NOW()
        )
    """)
    cur.execute("""
        CREATE TABLE IF NOT EXISTS behavior_decision_log (
            id SERIAL PRIMARY KEY,
            order_id INTEGER,
            order_no TEXT,
            openid TEXT,
            user_phone TEXT,
            score NUMERIC,
            threshold NUMERIC,
            hits JSONB,
            is_high_risk SMALLINT,
            action TEXT,               -- 'record_only' / 'auto_refund' / 'skipped'
            dry_run SMALLINT DEFAULT 1,-- 是否灰度（1=只记录）
            refund_id INTEGER,
            deposit_amount NUMERIC,
            window_min INTEGER,
            created_at TIMESTAMP DEFAULT NOW()
        )
    """)
    cur.execute("CREATE INDEX IF NOT EXISTS idx_bdl_order ON behavior_decision_log(order_id)")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_bdl_created ON behavior_decision_log(created_at DESC)")
    db.commit()
    # 写入默认配置（幂等）
    for name, kind, th, pts in DEFAULT_SCORE_TABLE:
        cur.execute("""INSERT INTO behavior_score_config (signal_name, signal_type, threshold, points)
                       VALUES (%s,%s,%s,%s) ON CONFLICT (signal_name) DO NOTHING""",
                    (name, kind, th, pts))
    cur.execute("""INSERT INTO behavior_score_settings (key, value) VALUES ('threshold', %s)
                   ON CONFLICT (key) DO NOTHING""", (str(DEFAULT_THRESHOLD),))
    cur.execute("""INSERT INTO behavior_score_settings (key, value) VALUES ('window_min', %s)
                   ON CONFLICT (key) DO NOTHING""", (str(DEFAULT_WINDOW_MIN),))
    cur.execute("""INSERT INTO behavior_score_settings (key, value) VALUES ('dry_run', '1')
                   ON CONFLICT (key) DO NOTHING""")
    cur.execute("""INSERT INTO behavior_score_settings (key, value) VALUES ('enabled', '1')
                   ON CONFLICT (key) DO NOTHING""")
    db.commit()
    cur.close()


def load_config(db):
    """从数据库读配置（兼容字典游标和元组游标）"""
    cur = db.cursor()
    try:
        cur.execute("""SELECT signal_name AS a, signal_type AS b, threshold AS c, points AS d
                       FROM behavior_score_config WHERE enabled=1 ORDER BY id""")
        table = []
        for r in cur.fetchall():
            if isinstance(r, dict):
                table.append((r.get('a'), r.get('b'), float(r.get('c')), float(r.get('d'))))
            else:
                table.append((r[0], r[1], float(r[2]), float(r[3])))
        cur.execute("SELECT key AS k, value AS v FROM behavior_score_settings")
        st = {}
        for r in cur.fetchall():
            if isinstance(r, dict):
                st[r.get('k')] = r.get('v')
            else:
                st[r[0]] = r[1]
        return {
            'table': table or DEFAULT_SCORE_TABLE,
            'threshold': float(st.get('threshold') or DEFAULT_THRESHOLD),
            'window_min': int(float(st.get('window_min') or DEFAULT_WINDOW_MIN)),
            'dry_run': str(st.get('dry_run', '1')) == '1',
            'enabled': str(st.get('enabled', '1')) == '1',
        }
    finally:
        cur.close()


def log_decision(db, order, feat, result, action='record_only',
                 dry_run=True, refund_id=None, window_min=360):
    """记录决策（可审计）"""
    cur = db.cursor()
    try:
        cur.execute("""
            INSERT INTO behavior_decision_log
              (order_id, order_no, openid, user_phone, score, threshold, hits,
               is_high_risk, action, dry_run, refund_id, deposit_amount, window_min)
            VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)
        """, (
            order.get('id'), order.get('order_no'), order.get('mp_openid'),
            order.get('user_phone'), result['score'], result['threshold'],
            json.dumps(result['hits'], ensure_ascii=False),
            1 if result['is_high_risk'] else 0, action, 1 if dry_run else 0,
            refund_id, order.get('deposit_amount'), window_min,
        ))
        db.commit()
    except Exception as e:
        logger.warning('[behavior_scorer] 决策记录失败: %s' % e)
        try:
            db.rollback()
        except Exception:
            pass
    finally:
        cur.close()


# ══════════════════════════════════════════════════════════
# 特征来源：从 user_behavior_log 表读（或 nginx 日志回填）
# ══════════════════════════════════════════════════════════
def features_from_log(db, openid, t_from, t_to, late_from=None):
    """从 user_behavior_log 表读行为并提取特征"""
    cur = db.cursor()
    try:
        cur.execute("""
            SELECT created_at AS ts, path
            FROM user_behavior_log
            WHERE openid = %s AND created_at >= %s AND created_at <= %s
            ORDER BY created_at
        """, (openid, t_from, t_to))
        events = []
        for r in cur.fetchall():
            ts = r['ts'] if isinstance(r, dict) else r[0]
            path = r['path'] if isinstance(r, dict) else r[1]
            if isinstance(ts, str):
                s = ts[:19]
                for fmt in ('%Y-%m-%d %H:%M:%S', '%Y-%m-%dT%H:%M:%S'):
                    try:
                        ts = datetime.strptime(s, fmt)
                        break
                    except Exception:
                        continue
            if hasattr(ts, 'year') and path:
                events.append((ts, path))
        return extract_features(events, late_from=late_from)
    except Exception as e:
        logger.warning('[behavior_scorer] 读行为日志失败: %s' % e)
        return None
    finally:
        cur.close()
